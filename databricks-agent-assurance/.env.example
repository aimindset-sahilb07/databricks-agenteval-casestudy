# Copy to .env (gitignored) and fill in. Never commit .env.
# Direct route: log from this machine to Databricks MLflow.
MLFLOW_TRACKING_URI=databricks
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal-access-token>
MLFLOW_EXPERIMENT_NAME=/Shared/agent-assurance

# Local test without Databricks (uncomment, comment out the lines above).
# MLflow 3.17 refuses the file store unless explicitly allowed; fine for testing only.
# MLFLOW_TRACKING_URI=mlruns
# MLFLOW_ALLOW_FILE_STORE=true
# MLFLOW_EXPERIMENT_NAME=agent-assurance-local
